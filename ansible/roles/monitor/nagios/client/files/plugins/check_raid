if [[ $# -eq 1 ]]
then
  if [[ $1 -eq $1 ]]
  then
    time_interval=$1
  else
    input_msg="$1"
  fi
fi

if [[ $# -eq 2 ]]
then
  time_interval=$1
  input_msg=$2
fi

time_now=$(date +%s)
filetime=$(stat -c%Z $timestamp)
diffval=$((time_now-filetime))

[[ -f $timestamp ]] && [[ ${diffval#-} -lt $time_interval ]] && checkallout
rcode=$?

#echo -n "time_now:"$time_now" filetime:"$filetime "time_now - filetime: "${diffval#-} "time_interval:"$time_interval

if [[ ! -f $timestamp ]] || [[ ${diffval#-} -ge $time_interval ]]
then
    check_infrequ $input_msg > $timestamp
    rcode=$?
    if [[ -z $rcode ]]
    then
       rcode=2
    fi
    echo >> $timestamp
    echo $rcode >> $timestamp && checkallout
fi
exit $rcode

