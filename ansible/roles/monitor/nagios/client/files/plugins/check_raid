storcli() {
    if ! which storcli64 > /dev/null 2>&1
    then
       STORCLI="/opt/MegaRAID/storcli/"
    fi
    vendor=$(dmidecode -t system  | grep dell -io)
    CLICMD=storcli64
    [[ $vendor =~ Dell ]] && (lspci | grep -Ei "megaraid") > /dev/null && STORCLI="/opt/MegaRAID/perccli" && CLICMD=perccli64
    export PATH=$PATH:$STORCLI
    if echo "$MegaRAID_out" | grep -i "No Controller" > /dev/null
    then
        echo -n "No MegaRAID,"
    else
        MegaRAID_out=$($CLICMD /call show all)
        echo "$MegaRAID_out" |  awk 'BEGIN {rcode=0}
        {
                if($0~/BBU Status/) {
                        if ($NF==0 || $NF~/NA/)
                        {
                            printf "Batt: "$NF ";"
                        } else {
                            printf "Batt: "$NF ";"
                            rcode=1
                        }
                }
                if ($0~/Controller Status/ && $0!~/Peer Controller Status/) {
                       if ($NF~/Optimal/ || $NF~/OK/ || $NF~/Active/) {
                        printf "Con: "$NF";"
                       } else {
                        printf "Con: "$NF";"
                        rcode=2
                       }
                }
                if($2~/RAID/ && $1~/^[0-9]/) {
                        if ($3~/Optl/) {
                                printf "lv: "$2" "$3";"
                        } else {
                                printf "lv: "$2" "$3";"
                                rcode=2
                        }
                }
        } END {exit rcode}'
    fi
    rcode=$?
    return $rcode
}
hpraid() {
        [[ ! -f /dev/shm/nrpe_c2babed0c4be41f6/hpe_raid_bdab105ca4a3f441 ]] && hpssacli ctrl all show  | awk -F '[() ]+' '$0!~/HBA/ {if($6>=0) print $6}'  > /dev/shm/nrpe_c2babed0c4be41f6/hpe_raid_bdab105ca4a3f441
        while read line
        do
               #check raid
           if [[ $line == ?(-)+([0-9]) ]]
           then
               hpssacli ctrl slot=$line show config  | awk -F '[() ]+' '{
                 if($0~/physicaldrive/) {
                   if($(NF-1)!~/OK*/ || length($(NF-1))==0)
                      {printf $3":"$(NF-1)" "; rcode=2}
                   }
               }END {exit rcode}'
               hpssacli ctrl slot=$line show | awk '{if($0~/Capacitor Status/ && $NF=="OK") {a[0]=$NF} else if(a[0]!="OK") {a[0]="No found"}; if ($0~/Controller Temperature/) {a[1]=$NF} else if(a[1]!~/^[0-9]+$/) {a[1]="not get temperature"}}
               END{
