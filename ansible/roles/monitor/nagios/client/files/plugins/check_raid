check_infrequ () {
hr=(megaraid hewlett-packard fusion marvell emulex adaptec)
sr=(raid zfs)
raidchip=()
for ((i=0;i<${#hr[*]};i++))
do
    lspcivar=$(lspci | grep -Ei 'raid|scsi|sata|Fibre./*Channel' |  grep -io ${hr[$i]} | uniq)
    raidchip+=($lspcivar)
done
for ((i=0;i<${#sr[*]};i++))
do
    lspcivar=$(lsmod |  grep -Eio ${sr[$i]} | uniq)
    raidchip+=($lspcivar)
done

###echo -n "RAID type: "${raidchip[*]}" "
###echo -n "-"${#raidchip[@]}"-"
declare -A check_res_arr
if [ ${#raidchip[@]} -eq 0 ]
then
    echo -n "Not reconnise sas/raid chip" && return 1
else
  for key in ${!raidchip[@]}
  do
    #echo "raidchip:"${raidchip[${key}]}
    if [ -n "${raidchip[${key}]}" ]
    then
    case "$(echo ${raidchip[${key}]} | awk '{print tolower($0)}')" in
    zfs)
        raidz;
        check_res_arr["zfs"]=$?
    ;;
    raid)
        mdraid;
        check_res_arr["mdraid"]=$?
    ;;
    megaraid)
        storcli;
        check_res_arr["megaraid"]=$?
    ;;
    hewlett-packard)
        hpraid;
        check_res_arr["hpe"]=$?
    ;;
    fusion)
        fusionraid;
        check_res_arr["fusion"]=$?
    ;;
    marvell)
        Marvell;
        check_res_arr["marvell"]=$?
    ;;
    adaptec)
        Adaptec;
        check_res_arr["adaptec"]=$?
    ;;
    emulex)
        Emulex $1;
        check_res_arr["emulex"]=$?
    ;;
    *)
        echo -n "No raid chip"
        return 3
    ;;
    esac
    fi
  done

  psu_fan_status;
  check_res_arr["psu_zfs"]=$?

  for ak in "${!check_res_arr[@]}"
  do
    if [[ ! ${check_res_arr[$ak]} -eq 0 ]]
    then
       echo -n " err:$ak;"
       return ${check_res_arr[$ak]}
    fi
  done
fi
}

