is_md34() {
### Just for patch MD3420, beacuse "SMcli localhost" not work for MD3420
   while read line
   do
      [[ -z $line ]] && continue
      if [ -n $line ]
      then
         check_md34 "dell" $line
         rcode=$?
         if [[ $rcode -eq 2 ]] 
         then
            return $rcode
         fi
      fi
   done <<< "$(SMcli localhost -n storagename -c "show storageArray;" 2>&1 |  grep -A 5 "Valid Storage" | grep -vEi 'Valid Storage|SMcli failed' | awk '$0!~/^$/ {print $1}')"
   return $rcode
}
check_md34() {
  [[ -z $1 ]] && [[ -z $2 ]] && 'echo check_md34 not found $1 or $2 parameter'
  smclioutput="/dev/shm/nrpe_c2babed0c4be41f6/found_md34xx_devices_$2"
  
  if [[ $1 == "dell" ]]
  then  
    SMcli localhost -n $2 -c "Show allVirtualDisks;show storageArray; Show allphysicalDisks summary;" > $smclioutput
  fi
  if [[ $1 == "lenovo" ]]
  then  
    SMcli -k $2  -u admin -P /opt/SMcli-01.50.00.9001/bin/password -c "show storageArray;" > $smclioutput
  fi
  if [[ $? -eq 0 ]]
  then
  awk 'BEGIN {
    rcode2=0;} {
    if(NF>10 && $0~/Disk Group/ && $0!~/Optimal/){
         printf "Vol"$NF":"$3";"$4";"
         rcode2=2
    };
    if($0~/mirroring/)
    {
       if($NF!~/Enabled/) {
         printf "Cache mirror:"$NF";"
         rcode2=2
       }
    };
    if($0~/Battery status/) {
       if($NF!~/Optimal/) {
         printf "Batt:"$NF";"
         rcode1=1
      }
    };
    if ($0~/Power supply status/) {
         if ($NF!~/Optimal/) {
         printf "Power status:"$NF";"
         rcode2=2
         }
    };
    if ($0~/Fan Status/) {
         if ($NF!~/Optimal/) {
         printf "Fan status:"$NF";"
         rcode2=2
         }
    };
    if ($0~/Number of enclosures/) {
         nenclo=$NF
    };
    if(($0!~/interface/) && ($0~/Solid State Disk.*SAS|Physical Disk.*SAS/)) {
         if ($0~/Replaced/) {
             printf " to resilvering:"$(NF-2),$(NF-1),$NF";"
             rcode1=1
         }
         else if ($0!~/Optimal/) {
             printf "%d %d %d %s %s %s;",$1,$2,$3,$4,$5,$(NF-2)
             rcode2=2
         }
    }
  } END{ if(rcode2==0 && rcode1==0) {
      printf "MD34 is ok;"
    } else if(rcode2==2) {
      exit rcode2
    } else if(rcode1==1) {
      exit rcode1
    }
  }' $smclioutput
  else
     echo "SMcli not run"
     return 2
  fi
}

