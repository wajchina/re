                     rcode=1;
                  }
                    printf " Temper(C):"a[1] " Capacitor:"a[0]; exit rcode
               }'
           else
               echo "Could not got the slot number" && return 2
           fi
        done < /dev/shm/nrpe_c2babed0c4be41f6/hpe_raid_bdab105ca4a3f441
}
