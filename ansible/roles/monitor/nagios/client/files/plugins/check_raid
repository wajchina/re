Adaptec() {
    export PATH=$PATH:/usr/Arcconf
    checkcmd arcconf
    export PATH=$PATH:/usr/Arcconf
    for i in $(arcconf LIST |  awk '$0~/Controller [0-9]/ {gsub(":","");print $2}')
    do
        output=$(arcconf getconfig $i)
        if echo "$output" | grep "No logical devices configured" > /dev/null
        then
           echo -n "Adaptec: No logical devices configured; "
        else
           echo "$output" | grep -i "RAID level" | awk '$NF==0 {printf "Got raid0, check the config !!!"; exit 1}'
           raidl=$?
           echo "$output" | awk -v "con=$i" '{if($0~/Logical Device number /) {lov=$NF}; if($0~/Status of Logical Device/) { if($0~/Optimal/) {printf "con "con" lov-"lov": "$NF" "} else {printf "con "con" lov-"lov": "$NF" ";exit 2} }}'
           rcode=$?
        fi
        echo "$output" | grep "Drive has stale RIS data" -B 1 | grep State | awk '$NF!~/Online/ && $NF!~/Ready/ && $NF!~/Hot-Spare/ {printf "Get adaptec bad dev: "$NF; exit 2}'
        hbacode=$?
        if [[ $rcode -gt 0 ]]
        then
           return $rcode
        fi
        if [[ $raidl -gt 0 ]]
        then
           return $raidl
        fi
        if [[ $hbacode -gt 0 ]]
        then
           return $hbacode
        fi
    done
}

function check_ibm_raid {
