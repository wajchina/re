psu_fan_status() {
  ######### JBOD power fan status
  export PATH=$PATH:/opt/dell/ServerHardwareManager/ServerHardwareManagerCLI/bin
    if lsscsi -gis | grep -Ei "Array584|MD1280|DELL     EN-8435" > /dev/null
    then
         shmcli_output=$(timeout 90 shmcli list physical enclosures)
         if echo "$shmcli_output" | grep -E '\w{16,16}' > /dev/null
         then
           all_shmout=$(echo "$shmcli_output" | awk 'NF < 4 {getline nextline; $0 = $0 nextline} 1' | awk '$0~/500/|| $0~/520/{print $3,$5}' | while read line
           do
             jbod_sn=$(echo $line| awk '{print $1}')
             jbod_addr=$(echo $line| awk '{print $2}')
             timeout 90 shmcli list power supplies -enc = $jbod_addr
             [[ ! $? -eq 0 ]] && echo "list power error" && return 2
             timeout 90 shmcli list fans -enc = $jbod_addr
             [[ ! $? -eq 0 ]] && echo "list fan error" && return 2
           done)
           echo "$all_shmout" | awk '{gsub("Top","PS 0"); gsub("Bottom","PS 1");if($1~/jbod_serial/) {printf "jbod: "$2} ; if($1~/PS/) {if ($3!~/OK/ && NF>4) {printf $1" "$2" lost power "$3" ";rcode=2} }; if ($1 ~ /^[0-9]/ && $2!~/OK/ && NF>3){printf " fan "$1" stopped "$2" "; rcode=2}; } END{exit rcode}'
           if [[ $? -eq 2 ]] 
           then 
             return 2
           else
             echo -n "shmcli PSU/Fan:OK;"
           fi
         else
           echo "shmcli no output" 
           return 1
         fi
    else
      echo -n "no Dell JBOD;"
    fi
    lsscsi_output="$(lsscsi -gis | grep -Ei 'enclosu SMC +SC826|enclosu SMC +SC[0-9]|enclosu SMC94[0-9] +12|enclosu DELL +MD3060e|enclosu SMCI +JBOD-[B,T]O[T,P]|enclosu SMCDRS2U SAS3|enclosu Seagate|HP +D3700|enclosu HGST|enclosu WDC|enclosu LENOVO   D32845U' | awk '{print $(NF-1)}')"
    if echo $lsscsi_output | grep dev\/sg > /dev/null
    then
      while read line
      do
          if [[ $line =~ sg ]]
          then
              if [[ -f /sys/class/scsi_generic/$(basename $line)/device/vpd_pg80 ]]
              then
                jbod_sn=$(strings /sys/class/scsi_generic/$(basename $line)/device/vpd_pg80 | tr -d '\040\011\012\015')
                smc_output=$(/sbin/smc_enclo_tools $line | grep -vi unsupport | sed -e 's/:/ /g' -e 's/,/ /g' | grep -Ei 'PSU|Fan')
                if [[ ! $? -eq 0 ]]
                then
                   echo "no SMC ouotput"
                fi 
              fi

              if [[ $(echo "$smc_output" | grep -ci PSU) -ge 2 ]] && [[  $(echo "$smc_output" | grep -ci Fan) -ge 1 ]]
              then
                while read psu_status
                do
                  dev_name=$(echo $psu_status | cut -d" " -f1)
                  dev_stat=$(echo $psu_status | cut -d" " -f2)
                  echo -n "SMC OK;"
                  if echo $dev_stat | grep -vi OK >/dev/null
                  then
                     echo -n "failed JBOD: $jbod_sn $dev_name $dev_stat;"
                     return 2;
                  fi
                done <<<$(echo "$smc_output")
              fi
          else
            echo " failed SMC dev: $line;"
            return 1
          fi
      done <<<"$(echo "$lsscsi_output")"
   else
      echo -n "No SMC JBOD;"
   fi
}

raidz() {
    if cat /proc/filesystems | grep -o zfs > /dev/zero 2>&1
    then
      if zpool list | grep "no pools" > /dev/null
      then
          echo "no zfs;"; return 0;
      fi

      if modinfo zfs | grep zfs.ko -A 1 | grep -v 0.6 >/dev/zero
      then
        zpool get multihost | grep off; [[ $? -eq 1 ]] || set_rcode=2
        zfs get quota | grep none; [[ $? -eq 1 ]] || set_rcode=2
      fi
      ######### zpool events
      this_month=$(date '+%b')
      this_day=$(date '+%d' | awk '{printf "%d\n",$1}')
      this_hour=$(date +%H)
      this_year=$(date +%Y)
      zpoolevent=$(zpool events | grep -Ei "${this_month}\ +${this_day}.+${this_year}" | grep -Ec 'resilver_|scrub_')
      if [[ $zpoolevent -gt 20 ]]
      then
        echo "too many resilvering/scrub" 
        set_rcode=2
      fi

      ######### resilvering status
      zpool_out="$(zpool status 2>/dev/null)"
      res_code=0
      if [[ -s /dev/shm/nrpe_c2babed0c4be41f6/zpool_resilvering ]]
      then
        if echo "$zpool_out" | grep resilvering > /dev/null
        then
          resilvering_t=$(stat -c%Z /dev/shm/nrpe_c2babed0c4be41f6/zpool_resilvering)
          now_t=$(date +%s)
          resilvering_timeo=$((now_t-resilvering_t)) 
          if [[ $resilvering_timeo -gt 1728000 ]]
          then
            while read line
            do
              if grep "$line" /dev/shm/nrpe_c2babed0c4be41f6/zpool_resilvering > /dev/null
              then
                echo -n " $line "
                res_code=2
              fi
            done <<< "$(echo "$zpool_out" | awk '/resilvering/ {print $1}')"

            if [[ $res_code -eq 2 ]]
            then
              echo -n " resilvering timeout, critical;"
              echo "$zpool_out" | awk '/resilvering/ {print $1}' > /dev/shm/nrpe_c2babed0c4be41f6/zpool_resilvering
              return $res_code
            fi
          fi
        else
          echo -n $(cat /dev/shm/nrpe_c2babed0c4be41f6/zpool_resilvering) " resilvering completed; " && rm -f /dev/shm/nrpe_c2babed0c4be41f6/zpool_resilvering
        fi
      else 
         if echo "$zpool_out" | grep resilvering > /dev/null
         then
            echo "$zpool_out" | awk '/resilvering/ {print $1}' > /dev/shm/nrpe_c2babed0c4be41f6/zpool_resilvering
            if [[ $? -gt 0 ]]
            then
              echo "write zpool_resilvering failed"
              res_code=2
            fi
         fi
      fi

      ########## raid status
      echo "$zpool_out" | awk -v rcode=$rcode '{
                if($0~/no pools available/) {exit 0};
                if(tolower($0)~/pool:/) pname=$NF
                else if(tolower($0)~/state:/ && $NF!="ONLINE") {
                       pstat_rc=2; pstat=$NF; epool=pname
                } else if (tolower($0)~/resilvering/) {
                       rebu=1;epool=pname
                }
                else if($3~/^[[:digit:]]/ && $4~/^[[:digit:]]/ && $5~/^[[:digit:]]/) {
                     if($3>0 || $4>0 || $5>0) {
                        a[$1]=$3+$4+$5; epool=pname
                               if(match($3,/[K,M,G,T,P]$/,m) || match($4,/[K,M,G,T,P]$/,m) || match($5,/[K,M,G,T,P]$/,m)) {
                                  if(m[0]!=0 && m[0]+0==0) {cks_m=m[0];}
                               }
                     }
               }
       }
       END{
                        hddnum=0
                        for (i in a) {
                                if (a[i]>0) {
                                        sum+=a[i]
                                        hddnum++
                               }
                        }
	                if (rebu==1) {
                            printf " "epool" is resilvering "
                            rcode=1
                        } else {
                            if (sum>15 || hddnum>0 || pstat_rc >=2 || length(cks_m) > 0) {
                                   printf " "epool" "pstat";rw-cksum err:"sum""cks_m";err devs:"hddnum";"
                                   rcode=2
                            } else {
                                   printf " raidz no error;"
                                   rcode=0
                            }
                        }
                        exit rcode
        }'
    fi
    rcode=$?
    if [[ $rcode -eq 2 ]] || [[ $set_rcode -eq 2 ]] || [[ $res_code -eq 2 ]]
    then
      return 2
    else
      return $rcode
    fi
}

mdraid() { #there is no output in mdstat, not return error
    if cat /proc/mdstat | grep -iE 'Personalities.*raid' > /dev/zero
        then
        cat /proc/mdstat | awk -F '[][ //]+' '
                BEGIN {
                COUNT=0;rcode=0
                }
                {
                        if ($0~/U/)
                        {
                        LINES[COUNT]=$0
                        COUNT++
                        }
                }
                        END{
                        for (j=0;j<=COUNT;j++)
                        {
                                        if (LINES[j]~/_/)
                                        {
                                                printf "SoftRaid [critical];"
                                                rcode=2
                                                break
                                        }
                        }
                        if (rcode==0) {
                                printf "SoftRaid [ok];"
                        } else {
                                exit rcode
                        }
                       }'
    return $?
    fi
}

